# Port API Express (Nuxt memakai 3000, jadi pakai port lain)
PORT=4000

# Connection string MongoDB. Ini sama dengan yang dipakai di MongoDB Compass.
# Pakai 127.0.0.1 (bukan localhost) agar aman dari masalah IPv6 di Node 18+.
# Nama database di ujung (hoopspot) akan dibuat otomatis saat seed dijalankan.
MONGODB_URI=mongodb://127.0.0.1:27017/hoopspot

# Rahasia penanda token login. WAJIB diganti dengan string acak panjang.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d

# Origin frontend yang boleh mengakses API (pisahkan dengan koma bila lebih dari satu)
CLIENT_URL=http://localhost:3000
