# Port server Express (Nuxt sudah memakai 3000)
PORT=4000

# Sama seperti connection string di MongoDB Compass.
# Pakai 127.0.0.1, bukan localhost (menghindari masalah IPv6 di Node 18+).
MONGODB_URI=mongodb://127.0.0.1:27017/hoopspot

# Kata rahasia untuk membuat token login. Isi bebas, makin panjang makin baik.
JWT_SECRET=ganti-dengan-kalimat-rahasia-kamu

# Alamat frontend Nuxt (untuk CORS)
CLIENT_URL=http://localhost:3000
